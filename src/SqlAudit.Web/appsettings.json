{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Storage": {
    "DatabasePath": "data/sqlaudit.db"
  },
  "Detection": {
    "RowsAbsoluteThreshold": 100000,
    "RowsExtremeThreshold": 1000000,
    "BaselineMultiplier": 8.0,
    "BaselineMinSamples": 20,
    "SuspiciousDelaySeconds": 1.0,
    "MaxFindingsPerStatement": 20,
    "ReportAndTautology": true
  }
}
